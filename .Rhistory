# ── a) Read dataset ──────────────────────────────────────────
amazon <- read.csv("amazon.csv", stringsAsFactors = FALSE)
# Clean discounted_price: remove ₹ and commas, convert to numeric
amazon$price_clean <- as.numeric(gsub("[₹,]", "", amazon$discounted_price))
colnames(amazon)
