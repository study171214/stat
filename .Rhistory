salary <- read.csv("Salary.csv", stringsAsFactors = FALSE)
hist(salary$Salary,
main = "Histogram of Salary",
xlab = "Salary")
boxplot(salary$Salary,
main = "Boxplot of Salary",
ylab = "Salary")
salary$Category <- ifelse(salary$Salary < 50000, "Low",
ifelse(salary$Salary < 100000, "Medium", "High"))
counts <- table(salary$Category)
barplot(counts,
main = "Salary Categories",
xlab = "Category",
ylab = "Count")
pie(counts,
main = "Salary Distribution")
plot(salary$YearsExperience, salary$Salary,
main = "Experience vs Salary",
xlab = "Years of Experience",
ylab = "Salary",
pch = 19)
h <- hist(salary$Salary, plot = FALSE)
plot(h$mids, h$counts, type = "l",
main = "Frequency Polygon",
xlab = "Salary",
ylab = "Frequency")
stem(salary$Salary)
p <- 0.1
n <- 10
lambda <- 3
mu <- 50
sigma <- 10
binom_prob <- dbinom(2, size = n, prob = p)
cat("Binomial P(X = 2):", binom_prob, "\n")
pois_prob <- dpois(2, lambda = lambda)
cat("Poisson P(X = 2):", pois_prob, "\n")
norm_prob <- pnorm(60, mean = mu, sd = sigma)
cat("Normal P(X < 60):", norm_prob, "\n")
z <- 1.96   # for 95% CI
lower <- mu - z * sigma
upper <- mu + z * sigma
cat("95% Confidence Interval: [", lower, ",", upper, "]\n")
salary <- read.csv("Salary.csv", stringsAsFactors = FALSE)
low_exp  <- salary$Salary[salary$YearsExperience < 5]
high_exp <- salary$Salary[salary$YearsExperience >= 5]
salary$Group <- ifelse(salary$YearsExperience < 3, "Low",
ifelse(salary$YearsExperience < 7, "Medium", "High"))
t1 <- t.test(salary$Salary, mu = 50000)
cat("=== One-Sample t-test ===\n")
print(t1)
t2 <- t.test(low_exp, high_exp)
cat("\n=== Two-Sample t-test ===\n")
print(t2)
anova_model <- aov(Salary ~ Group, data = salary)
cat("\n=== One-Way ANOVA ===\n")
summary(anova_model)
Dept   <- c("A", "A", "B", "B", "C", "C")
Result <- c("Pass", "Fail", "Pass", "Pass", "Fail", "Pass")
data <- data.frame(Dept, Result)
cat("=== Chi-square Test ===\n")
table_data <- table(data$Dept, data$Result)
print(table_data)
chi_test <- chisq.test(table_data)
print(chi_test)
data$Result_num <- ifelse(data$Result == "Pass", 1, 0)
group_A <- data$Result_num[data$Dept == "A"]
group_B <- data$Result_num[data$Dept == "B"]
cat("\n=== F-test ===\n")
f_test <- var.test(group_A, group_B)
print(f_test)
cat("\n=== Independent t-test ===\n")
t_test <- t.test(group_A, group_B)
print(t_test)
n <- 100
x <- 65
p_hat <- x / n
cat("=== Proportion Test ===\n")
prop_test <- prop.test(x, n, p = 0.5)
print(prop_test)
cat("\n=== Z-test ===\n")
p0 <- 0.5
z <- (p_hat - p0) / sqrt((p0 * (1 - p0)) / n)
p_value_z <- 2 * (1 - pnorm(abs(z)))
cat("Z value:", z, "\n")
cat("p-value:", p_value_z, "\n")
cat("\n=== t-test ===\n")
sample_data <- c(rep(1, x), rep(0, n - x))
t_test <- t.test(sample_data, mu = 0.5)
print(t_test)
cat("\n=== 95% Confidence Interval ===\n")
z_crit <- 1.96
margin <- z_crit * sqrt((p_hat * (1 - p_hat)) / n)
lower <- p_hat - margin
upper <- p_hat + margin
cat("CI:", lower, "to", upper, "\n")
