"about_product","user_id","user_name","review_id",
"review_title","review_content","img_link","product_link"
)
}
# Verify
cat("Columns:", ncol(amazon), "\n")
# ── Clean price ──────────────────────────────────────────────
amazon$price_clean <- as.numeric(gsub("[^0-9]", "", amazon$discounted_price))
# Remove NA
amazon <- amazon[!is.na(amazon$price_clean), ]
cat("Rows:", nrow(amazon), "\n\n")
# ── b) if/else ───────────────────────────────────────────────
classify_customer <- function(purchase_amount) {
if (purchase_amount < 500) {
return("Low Value Customer")
} else if (purchase_amount < 2000) {
return("Medium Value Customer")
} else {
return("High Value Customer")
}
}
# Example
cat("Example:", classify_customer(amazon$price_clean[1]), "\n\n")
# ── c) for loop ──────────────────────────────────────────────
cat("=== Customer Classification ===\n")
for (i in 1:min(10, nrow(amazon))) {
price <- amazon$price_clean[i]
cat("Product", i, "| Price:", price, "|", classify_customer(price), "\n")
}
# ── d) revenue function ──────────────────────────────────────
calculate_total_revenue <- function(prices) {
total <- sum(prices, na.rm = TRUE)
avg <- mean(prices, na.rm = TRUE)
cat("\n=== Revenue Summary ===\n")
cat("Total Revenue:", total, "\n")
cat("Average Price:", avg, "\n")
return(total)
}
calculate_total_revenue(amazon$price_clean)
# Segment distribution
segments <- sapply(amazon$price_clean, classify_customer)
cat("\n=== Segment Distribution ===\n")
print(table(segments))
salary <- read.csv("Salary.csv", stringsAsFactors = FALSE)
cat("Rows:", nrow(salary), "| Columns:", ncol(salary), "\n\n")
cat("Missing values BEFORE:\n")
print(colSums(is.na(salary)))
salary$YearsExperience[is.na(salary$YearsExperience)] <-
median(salary$YearsExperience, na.rm = TRUE)
salary$Salary[is.na(salary$Salary)] <-
median(salary$Salary, na.rm = TRUE)
cat("\nMissing values AFTER:\n")
print(colSums(is.na(salary)))
desc_stats <- function(x, name) {
x <- x[!is.na(x)]
mode_val <- as.numeric(names(sort(table(x), decreasing = TRUE))[1])
cat("\n---", name, "---\n")
cat("Mean     :", mean(x), "\n")
cat("Median   :", median(x), "\n")
cat("Mode     :", mode_val, "\n")
cat("SD       :", sd(x), "\n")
cat("Variance :", var(x), "\n")
cat("Range    :", diff(range(x)), "\n")
}
desc_stats(salary$YearsExperience, "YearsExperience")
desc_stats(salary$Salary, "Salary")
quartiles <- function(x, name) {
q <- quantile(x, probs = c(0.25, 0.5, 0.75), na.rm = TRUE)
cat("\n--- Quartiles:", name, "---\n")
cat("Q1:", q[1], "\n")
cat("Q2:", q[2], "\n")
cat("Q3:", q[3], "\n")
cat("IQR:", IQR(x, na.rm = TRUE), "\n")
}
quartiles(salary$YearsExperience, "YearsExperience")
quartiles(salary$Salary, "Salary")
cat("\n=== Comparison ===\n")
cat("YearsExperience Mean:", mean(salary$YearsExperience),
"| SD:", sd(salary$YearsExperience), "\n")
cat("Salary Mean:", mean(salary$Salary),
"| SD:", sd(salary$Salary), "\n")
cat("\nConclusion:\n")
cat("Salary increases as Years of Experience increases.\n")
cat("Salary shows higher variance compared to experience.\n")
cat("Data is positively correlated and roughly linear.\n")
